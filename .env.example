# GEMINI_API_KEY: Optional provider credential used for server-side extras.
# Keep credentials in server-side environment settings.
# Do not expose credentials in public browser code.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Provide the application's public base URL when needed.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
